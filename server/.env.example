# Copy to server/.env and fill in. Never commit the real .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnhub?retryWrites=true&w=majority

# Long random string used to sign login tokens
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Resend (resend.com > API Keys)
RESEND_API_KEY=
# Sender address on a domain verified in Resend (onboarding@resend.dev = test only, delivers to your own email)
EMAIL_FROM=LearnHub <onboarding@resend.dev>
# Where contact-form messages are delivered
CONTACT_EMAIL=

# Cloudflare R2 (Dashboard > R2 > Manage API tokens > Create token, "Object Read & Write")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=learnhub-media
# Public URL for the bucket (R2 > bucket > Settings > Public Development URL, e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# Public URL of this API (used in email verification links)
SERVER_URL=http://localhost:5000
# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173
PORT=5000
